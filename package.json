{
  "name": "printcost",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:android": "vite build --mode capacitor",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build:android && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build:apk": "npm run cap:sync && npx cap build android --androidreleasetype APK",
    "cap:build:aab": "npm run cap:sync && npx cap build android --androidreleasetype AAB",
    "cap:icons": "npx capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/share": "^8.0.2",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "description": "PrintCost - 3D print cost calculator, statistics, print history, and maintenance tracker."
}
